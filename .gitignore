# Codex runtime state (auth, sessions, caches, sqlite dbs, plugins) - only config.toml is tracked
.codex/*
!.codex/config.toml

# Downloaded installer artifacts
install-scripts/lazygit
install-scripts/lazygit.tar.gz

# Stray symlink to ghostty/config
.config/config

# herdr runtime state (logs, sockets, sessions)
.config/herdr/*.log
.config/herdr/herdr.sock*
.config/herdr/session.json
.config/herdr/session-snapshots/
.config/herdr/release-notes.json
.config/herdr/.plugins.lock
