# {{ rice_theme_name }} (rice template, from theme-sync's Vesper file)
gui:
  theme:
    activeBorderColor:
      - '{{ accent }}'
      - bold
    inactiveBorderColor:
      - '{{ ui_border }}'
    optionsTextColor:
      - '{{ accent }}'
    selectedLineBgColor:
      - '{{ selection }}'
    selectedRangeBgColor:
      - '{{ selection }}'
    cherryPickedCommitBgColor:
      - '{{ ui_surface }}'
    cherryPickedCommitFgColor:
      - '{{ accent }}'
    unstagedChangesColor:
      - '{{ ui_danger }}'
    defaultFgColor:
      - '{{ foreground }}'
    searchingActiveBorderColor:
      - '{{ accent }}'
