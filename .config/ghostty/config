# Font
font-family = "Fira Code SemiBold"
font-style = "SemiBold"
font-size = 10
adjust-cell-height = 30%

theme = Vesper

# Window
window-padding-x = 9
window-padding-y = 9
window-decoration = auto
gtk-wide-tabs = false
window-theme = ghostty
window-show-tab-bar = auto
gtk-titlebar = false
window-show-tab-bar = always

# Terminal Behavior
command = /bin/zsh
scrollback-limit = 10000
shell-integration-features = no-cursor
bell-features = no-audio
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 5s

# Cursor
cursor-style = block
cursor-style-blink = false

# Mouse
mouse-hide-while-typing = false

# Visual
background-opacity = 1
unfocused-split-opacity = 1
bold-is-bright = true

# Clipboard
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# Keybindings
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+shift+\=new_split:right
keybind = ctrl+shift+-=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+m=toggle_split_zoom
keybind = ctrl+shift+r=reload_config
