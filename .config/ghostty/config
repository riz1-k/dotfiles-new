# Font
font-family = "MonoLisa"
font-family = "SFMono Nerd Font"
font-family-bold = "MonoLisa"
font-family-italic = "MonoLisa"
font-family-bold-italic = "MonoLisa"
# Bold weight everywhere (no italic, no separate bold cut)
font-style = "Bold"
font-style-bold = "Bold"
font-style-italic = "Bold"
font-style-bold-italic = "Bold"
font-size = 7.5
adjust-cell-height = 50%

# Colours: the rice theme (~/dotfiles/rice); `rice theme set` reloads every window.
config-file = ?~/.local/state/rice/current/theme/ghostty.conf

# Window
window-padding-x = 7
window-padding-y = 7
window-decoration = auto
gtk-wide-tabs = false
window-theme = ghostty
window-show-tab-bar = auto
gtk-titlebar = false
window-show-tab-bar = auto

# Terminal Behavior
command = /bin/zsh
scrollback-limit = 10000
shell-integration-features = no-cursor
bell-features = no-audio
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 5s

# Cursor
cursor-style = block
cursor-style-blink = false

# Mouse
mouse-hide-while-typing = false

# Visual
background-opacity = 1
unfocused-split-opacity = 1
# Off: some light themes' "bright" colors are the pale ones (Flexoki Light), so
# bold black text would turn light gray. Bold comes from the font weight instead.
bold-is-bright = false

# Clipboard
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# Keybindings
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+shift+\=new_split:right
keybind = ctrl+shift+-=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+m=toggle_split_zoom
keybind = ctrl+shift+r=reload_config
