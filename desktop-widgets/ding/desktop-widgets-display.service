[Unit]
Description=Keep the desktop widgets on the external display when one is connected
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 -I %h/.local/share/desktop-widgets/widgets-follow-display.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
