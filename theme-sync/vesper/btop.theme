# Vesper (https://github.com/raunofreiberg/vesper)

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#101010"

# Main text color
theme[main_fg]="#ffffff"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ffc799"

# Background color of selected item in processes box
theme[selected_bg]="#232323"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffc799"

# Color of inactive/disabled text
theme[inactive_fg]="#505050"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#ffffff"

# Background color of the percentage meters
theme[meter_bg]="#232323"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#a0a0a0"

# Cpu box outline color
theme[cpu_box]="#ffc799"

# Memory/disks box outline color
theme[mem_box]="#99ffe4"

# Net up/down box outline color
theme[net_box]="#ff8080"

# Processes box outline color
theme[proc_box]="#aca1cf"

# Box divider line and small boxes line color
theme[div_line]="#282828"

# Temperature graph colors
theme[temp_start]="#99ffe4"
theme[temp_mid]="#e6b99d"
theme[temp_end]="#ff8080"

# CPU graph colors
theme[cpu_start]="#bcffed"
theme[cpu_mid]="#ffc799"
theme[cpu_end]="#ff8080"

# Mem/Disk free meter
theme[free_start]="#bcffed"
theme[free_mid]="#99ffe4"
theme[free_end]="#447266"

# Mem/Disk cached meter
theme[cached_start]="#c9c1df"
theme[cached_mid]="#aca1cf"
theme[cached_end]="#4d485d"

# Mem/Disk available meter
theme[available_start]="#eed1bf"
theme[available_mid]="#e6b99d"
theme[available_end]="#675346"

# Mem/Disk used meter
theme[used_start]="#ffacac"
theme[used_mid]="#ff8080"
theme[used_end]="#723939"

# Download graph colors
theme[download_start]="#f1aec4"
theme[download_mid]="#ea83a5"
theme[download_end]="#693a4a"

# Upload graph colors
theme[upload_start]="#ffdabc"
theme[upload_mid]="#ffc799"
theme[upload_end]="#725944"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#ffc799"
theme[process_mid]="#e6b99d"
theme[process_end]="#7e7e7e"
