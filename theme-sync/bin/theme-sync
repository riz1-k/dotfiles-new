#!/usr/bin/env bash
# theme-sync — keep the whole rice in step with GNOME's light/dark style.
#
#   dark  (color-scheme = prefer-dark)       -> Vesper
#   light (color-scheme = default / prefer-light) -> Flexoki Light
#
# Usage:
#   theme-sync            apply the mode GNOME is currently in
#   theme-sync --watch    apply, then re-apply on every change (systemd service)
#   theme-sync dark|light force GNOME into that mode (the watcher does the rest)
#   theme-sync toggle     flip GNOME's mode
#
# Apps that follow the system natively are configured once and not touched
# here: ghostty, kitty, herdr, vicinae, yazi, GTK4/libadwaita, Discord
# (Vencord QuickCSS), VS Code, Chrome. This script handles the rest,
# including the Claude Code and Codex theme settings.
set -uo pipefail

SRC="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)" # ~/dotfiles/theme-sync
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/theme-sync"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
IFACE=org.gnome.desktop.interface

current_mode() {
  [[ $(gsettings get $IFACE color-scheme) == "'prefer-dark'" ]] && echo dark || echo light
}

log() { echo "theme-sync: $*" >&2; }

# Write atomically so watchers (nvim, zsh) never read a half-written file.
put() { printf '%s\n' "$2" >"$1.tmp" && mv -f "$1.tmp" "$1"; }

# Only touch a gsetting when it differs, to avoid change-notification loops.
gset() {
  local schema=$1 key=$2 val=$3
  [[ $(gsettings get "$schema" "$key" 2>/dev/null) == "$val" ]] && return
  gsettings set "$schema" "$key" "$val" 2>/dev/null || log "could not set $schema $key"
}

dset() { [[ $(dconf read "$1") == "$2" ]] || dconf write "$1" "$2"; }

apply() {
  local mode=$1 name gtk icons shell
  if [[ $mode == dark ]]; then
    name=vesper gtk=Yaru-dark icons=Colloid-Orange-Dark shell=Vesper
  else
    name=flexoki-light gtk=Yaru icons=Colloid-Orange-Light shell=Flexoki-Light
  fi
  mkdir -p "$STATE"

  # --- GNOME: legacy GTK3 theme, icons, shell theme ---------------------------
  gset $IFACE gtk-theme "'$gtk'"
  gset $IFACE icon-theme "'$icons'"
  gset org.gnome.shell.extensions.user-theme name "'$shell'"

  # --- GNOME Shell extensions (user-installed schemas: write via dconf) -------
  local dtp=/org/gnome/shell/extensions/dash-to-panel p7=/org/gnome/shell/extensions/p7-borders
  local rwc=/org/gnome/shell/extensions/rounded-window-corners-reborn
  if [[ $mode == dark ]]; then
    dset $dtp/trans-bg-color "'#1a1a1e'"
    dset $dtp/trans-border-custom-color "'rgba(255,255,255,0.18)'"
    dset $dtp/highlight-appicon-hover-background-color "'rgba(255,255,255,0.10)'"
    dset $dtp/highlight-appicon-pressed-background-color "'rgba(255,255,255,0.16)'"
    for i in 1 2 3 4; do dset $dtp/dot-color-$i "'#FFC799'"; done
    dset $p7/default-active-color "'rgba(255, 199, 153, 0.5)'"
    # rounded-window-corners: its stock shadows
    dset $rwc/focused-shadow "{'horizontalOffset': 0, 'verticalOffset': 4, 'blurOffset': 28, 'spreadRadius': 4, 'opacity': 60}"
    dset $rwc/unfocused-shadow "{'horizontalOffset': 0, 'verticalOffset': 2, 'blurOffset': 12, 'spreadRadius': -1, 'opacity': 65}"
  else
    dset $dtp/trans-bg-color "'#f2f0e5'"
    dset $dtp/trans-border-custom-color "'rgba(16,15,15,0.12)'"
    dset $dtp/highlight-appicon-hover-background-color "'rgba(16,15,15,0.08)'"
    dset $dtp/highlight-appicon-pressed-background-color "'rgba(16,15,15,0.14)'"
    for i in 1 2 3 4; do dset $dtp/dot-color-$i "'#BC5215'"; done
    dset $p7/default-active-color "'rgba(188, 82, 21, 0.5)'"
    # softer shadows: the dark defaults look muddy on light backgrounds
    dset $rwc/focused-shadow "{'horizontalOffset': 0, 'verticalOffset': 3, 'blurOffset': 22, 'spreadRadius': 1, 'opacity': 22}"
    dset $rwc/unfocused-shadow "{'horizontalOffset': 0, 'verticalOffset': 2, 'blurOffset': 10, 'spreadRadius': -1, 'opacity': 18}"
  fi

  # --- GTK3 user CSS (GTK3 has no prefers-color-scheme media queries) --------
  ln -sfn "$SRC/$name/gtk3.css" "$CFG/gtk-3.0/gtk.css"

  # --- TUIs read at startup ---------------------------------------------------
  ln -sfn "$SRC/$name/gitui.ron" "$CFG/gitui/theme.ron"
  { echo "# GENERATED by theme-sync — edit ~/dotfiles/theme-sync/lazygit-base.yml instead"
    cat "$SRC/lazygit-base.yml"; sed '1d' "$SRC/$name/lazygit.yml"; } >"$CFG/lazygit/config.yml.tmp" &&
    mv -f "$CFG/lazygit/config.yml.tmp" "$CFG/lazygit/config.yml"
  [[ -f $CFG/btop/btop.conf ]] &&
    sed -i "s/^color_theme = .*/color_theme = \"$name\"/" "$CFG/btop/btop.conf"

  # --- tmux: re-source the palette in every running server --------------------
  ln -sfn "$SRC/tmux/$name.conf" "$STATE/tmux.conf"
  local sock
  for sock in /tmp/tmux-"$(id -u)"/*; do
    [[ -S $sock ]] && tmux -S "$sock" source-file "$STATE/tmux.conf" 2>/dev/null
  done

  # --- ghostty: follows the system itself (theme = light:..,dark:..); a config
  # reload (SIGUSR2) re-evaluates it in case it missed the change ------------
  pkill -USR2 -x ghostty 2>/dev/null

  # --- Claude Code: settings.json uses the custom theme "rice"; swapping what
  # ~/.claude/themes/rice.json points at re-themes running sessions live
  # (Claude watches its themes dir; it does not reload settings.json's theme).
  local claude_dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
  if [[ -d $claude_dir ]]; then
    mkdir -p "$claude_dir/themes"
    ln -sfn "$SRC/claude/$name.json" "$claude_dir/themes/rice.json"
    grep -q '^  "theme": "custom:rice"' "$claude_dir/settings.json" 2>/dev/null ||
      sed -i --follow-symlinks 's/^  "theme": "[^"]*"/  "theme": "custom:rice"/' "$claude_dir/settings.json"
  fi

  # --- Codex: [tui] theme names a .tmTheme in ~/.codex/themes (read at startup).
  # Only rewrite when it differs: Codex also writes this file. ---------------
  local codex_cfg=${CODEX_HOME:-$HOME/.codex}/config.toml
  if [[ -f $codex_cfg ]] && ! sed -n '/^\[tui\]$/,/^\[/p' "$codex_cfg" | grep -q "^theme = \"$name\"$"; then
    sed -i --follow-symlinks "/^\[tui\]$/,/^\[/ s/^theme = .*/theme = \"$name\"/" "$codex_cfg"
  fi

  # --- herdr: auto_switch follows the terminal; nudge it to re-read config ----
  command -v herdr >/dev/null && herdr server reload-config >/dev/null 2>&1

  # --- state for nvim (fs watcher) and the zsh prompt -------------------------
  put "$STATE/mode" "$mode"
  put "${XDG_STATE_HOME:-$HOME/.local/state}/TERMINAL_MODE" "$mode"

  log "applied $mode ($name)"
}

case "${1:-}" in
  --watch)
    apply "$(current_mode)"
    last=$(current_mode)
    # gsettings monitor prints one line per change; exits if the session bus dies
    # (systemd restarts us).
    gsettings monitor $IFACE color-scheme | while read -r _; do
      # Ubuntu's Appearance panel rewrites gtk/icon theme right after the
      # scheme flips; let it finish so our values win.
      sleep 0.4
      mode=$(current_mode)
      [[ $mode == "$last" ]] && continue
      last=$mode
      apply "$mode"
    done
    ;;
  dark | light)
    [[ $1 == dark ]] && gsettings set $IFACE color-scheme prefer-dark ||
      gsettings set $IFACE color-scheme default
    # without the watcher running, apply directly
    systemctl --user -q is-active theme-sync.service || apply "$1"
    ;;
  toggle) [[ $(current_mode) == dark ]] && "$0" light || "$0" dark ;;
  "") apply "$(current_mode)" ;;
  *) sed -n '2,15p' "$0"; exit 2 ;;
esac
